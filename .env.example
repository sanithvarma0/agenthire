# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI: reasoning in calls (fast) and writing/scoring (smart).
# Confirm current model names against OpenAI's model list at setup.
OPENAI_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=

# Sarvam: speech-to-text and text-to-speech
SARVAM_API_KEY=

# LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Twilio: phone line and SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_EDGE=singapore

# Google Places
GOOGLE_MAPS_API_KEY=

# Avatar provider
AVATAR_PROVIDER=
AVATAR_API_KEY=

# Hindsight memory (optional)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=

# Safety switches
# TEST_MODE is the demo toggle. true: providers are found for real, but every call
# rings DEMO_ROUTE_PHONE (you, playing the provider) instead of them. false: the
# real provider is called, within calling hours.
TEST_MODE=true
# A PIN that unlocks the test-mode switch in the web app's top bar. Leave empty to keep the
# switch locked (the deployed server and the submission zip always leave it empty).
TEST_MODE_PIN=
# Your own numbers (comma-separated, with country code). DEMO_ROUTE_PHONE must be one of them.
ALLOWED_NUMBERS=
# The phone that rings in test mode. Invites for sourced candidates also go here.
DEMO_ROUTE_PHONE=
DEMO_ROUTE_EMAIL=

# Shared secret the voice worker sends with events. Leave empty on a laptop; set before deploying.
INTERNAL_API_TOKEN=

# Local database file
DATABASE_PATH=data/agenthire.db

# Deployed server only: its own LiveKit agent name (the laptop uses config.yaml's "agenthire"),
# and where the worker reaches the back end.
AGENT_NAME=
BACKEND_URL=http://127.0.0.1:8000
